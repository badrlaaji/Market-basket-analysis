# Example settings. Copy to .env (ignored by Git) or export them; no secret here.

# API (FastAPI): folder with the pipeline outputs (Parquet files and stats.json)
OUTPUTS_DIR=./outputs

# Web app (Next.js, server side only): where FastAPI listens
# http://localhost:8000 in development, http://api:8000 inside Docker Compose
API_URL=http://localhost:8000
